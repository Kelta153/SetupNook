# Pooled/PgBouncer Neon connection string — apps/api runs on Deno
# Deploy's edge isolate and opens many short-lived connections via
# @prisma/adapter-neon, so use the pooled string, not packages/db's
# DIRECT_URL (that one's for migrations only).
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require"

# Generate with: deno eval "console.log(crypto.randomUUID() + crypto.randomUUID())"
BETTER_AUTH_SECRET=""

BETTER_AUTH_URL="http://localhost:8000"
